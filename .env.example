APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_DEFAULT_LOCALE=it
APP_FAKER_LOCALE=en_US

FILAMENT_PATH=cms-safehouse

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# DDEV Mailpit: host 127.0.0.1, port 1025 (inside container). CMS Integrations override these.
CONTACT_WEBSITE_FROM_ADDRESS=website@safehouse.community
CONTACT_WEBSITE_FROM_NAME="Safe House — sito web"
# Sportelli: configure in CMS → Integrations → Email → Elenco sportelli
# Defaults below apply until saved in CMS:
CONTACT_DESK_DIGITAL_INBOX=sportello.digitale@safehouse.community
CONTACT_DESK_LEGAL_INBOX=sportello.legale@safehouse.community

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# EspoCRM — donation ledger (PrimaNota / Finanziamento)
# Spec (local, not in git): nonprofit-espocrm/docs/integrations/DONATION-SITE-CRM-API.md
ESPOCRM_BASE_URL=https://nonprofit-espocrm.ddev.site
ESPOCRM_API_KEY=
ESPOCRM_ASSIGNED_USER_ID=
ESPOCRM_PRIMA_NOTA_DEFAULT_SUBJECT=Donatore
ESPOCRM_PRIMA_NOTA_DEFAULT_BENEFICIARY=Safe House
ESPOCRM_FINANZIAMENTO_CLOSE_DATE=2026-12-31
ESPOCRM_FINANZIAMENTO_DEFAULT_AMOUNT=0
ESPOCRM_FINANZIAMENTO_DEFAULT_CURRENCY=EUR

# Stripe — embedded donations (standard account: Payment Element + webhooks, free)
# Setup guide: docs/STRIPE-SETUP.md — verify with: php artisan stripe:verify
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_CURRENCY=EUR
STRIPE_STATEMENT_DESCRIPTOR=SAFE HOUSE
# Production webhook URL (register in Stripe Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_URL=https://safehouse.community/api/webhooks/stripe

# Local dev without Stripe keys: auto mock when APP_ENV=local and STRIPE_SECRET is empty
# STRIPE_MOCK=true
# STRIPE_MOCK_PUBLISHABLE_KEY=pk_test_mock
