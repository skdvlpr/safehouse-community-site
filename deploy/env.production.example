APP_NAME="Safe House Community"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://safehouse.community

SEED_DEMO_CAROUSEL=false

APP_LOCALE=it
APP_FALLBACK_LOCALE=it

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=safehouse_community
DB_USERNAME=safehouse_site
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

FILAMENT_PATH=cms-safehouse

ESPOCRM_BASE_URL=https://crm.safehouse.community
ESPOCRM_API_KEY=
ESPOCRM_ASSIGNED_USER_ID=
ESPOCRM_FINANZIAMENTO_DEFAULT_AMOUNT=0
ESPOCRM_FINANZIAMENTO_DEFAULT_CURRENCY=EUR

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_CURRENCY=EUR
STRIPE_STATEMENT_DESCRIPTOR=SAFE HOUSE
STRIPE_ACCOUNT_ID=
STRIPE_ACCOUNT_NAME=Safe House
# Production webhook endpoint (register in Stripe Dashboard → Developers → Webhooks):
STRIPE_WEBHOOK_URL=https://safehouse.community/api/webhooks/stripe
# Leave unset on production when CMS has test/live keys. Mock is for local dev only.
# STRIPE_MOCK=false
