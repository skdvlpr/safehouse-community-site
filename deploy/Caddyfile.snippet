# Framing: X-Frame-Options MUST match PHP SecurityHeaders (DENY).
# Live apply of this snippet is owner-ops (root). Do not reload production Caddy from 001.2.
# CSP/HSTS in this file are not applied by the 001.2 feature.
# https://caddyserver.com/docs/caddyfile/directives/header

safehouse.community, www.safehouse.community {
    root * /var/www/safehouse-community-site/public
    encode zstd gzip

    @blocked_cms {
        path /cms-safehouse*
        not remote_ip 127.0.0.1 ::1
        # Add office/VPN IPs here, e.g.:
        # not remote_ip 203.0.113.10
    }
    respond @blocked_cms 403

    php_fastcgi unix//run/php/php8.4-fpm.sock
    try_files {path} {path}/ /index.php?{query}
    file_server

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    # CSP for the public site only — Filament/Livewire CMS breaks under strict CSP.
    # GTM + GA4-without-Ads + Preview hosts (002.2). No doubleclick / googleadservices.
    # https://caddyserver.com/docs/caddyfile/directives/header
    # https://developers.google.com/tag-platform/security/guides/csp
    @public_csp not path /cms-safehouse*
    header @public_csp Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://challenges.cloudflare.com https://www.googletagmanager.com https://tagmanager.google.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://challenges.cloudflare.com https://www.googletagmanager.com; connect-src 'self' https://api.stripe.com https://challenges.cloudflare.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.google.com; img-src 'self' data: https: https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://ssl.gstatic.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://tagmanager.google.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com"
}
